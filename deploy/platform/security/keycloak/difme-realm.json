{
  "realm": "difme",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and upperCase(1) and digits(1)",
  "otpPolicyType": "totp",
  "groups": [
    {
      "name": "ops"
    },
    {
      "name": "settlements"
    },
    {
      "name": "compliance"
    },
    {
      "name": "audit"
    },
    {
      "name": "analytics"
    },
    {
      "name": "process-designers"
    }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "backoffice",
      "name": "DIFME Back-Office",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://ops.difme.local/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://ops.difme.local",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://ops.difme.local/*"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "groups"
      ]
    },
    {
      "clientId": "ph-ee-ams",
      "name": "ph-ee-ams",
      "description": "Mifos payment hub Fineract connector: calls Fineract (OIDC federation) as Fineract user ph-ee-ams (claim fineract_user)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PH_EE_AMS_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "authorities",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "authorities",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "fineract_user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fineract_user",
            "claim.value": "ph-ee-ams",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "difme-exchange",
      "name": "difme-exchange",
      "description": "DIFME exchange: calls the Mifos payment hub channel API (role ph-ee-transfer)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DIFME_EXCHANGE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "authorities",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "authorities",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "card-issuer",
      "name": "card-issuer",
      "description": "DIFME card issuer: calls Fineract (savings holds/withdrawals, credit-line disbursements) as Fineract user card-issuer",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CARD_ISSUER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "fineract_user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fineract_user",
            "claim.value": "card-issuer",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "rails-worker",
      "name": "rails-worker",
      "description": "DIFME rails-worker (PH-EE DifmeOpenAccount): opens accounts in Fineract as Fineract user rails-worker (clients, savings accounts, interop identifiers; no money movement)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${RAILS_WORKER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "fineract_user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fineract_user",
            "claim.value": "rails-worker",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "loan-origination",
      "name": "loan-origination",
      "description": "Loan origination workflows (saga-orchestrator): book and disburse loans in Fineract as Fineract user loan-origination",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LOAN_ORIGINATION_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": { "access.token.lifespan": "900" },
      "protocolMappers": [
        {
          "name": "fineract_user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "fineract_user", "claim.value": "loan-origination", "jsonType.label": "String",
                      "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "fineract-admin",
      "name": "fineract-admin",
      "description": "Fineract bootstrap job only: acts as Fineract's admin user (mifos) to create the service users",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FINERACT_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "fineract_user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fineract_user",
            "claim.value": "mifos",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ph-ee-transfer",
        "description": "May start transfers through the Mifos payment hub channel API"
      }
    ]
  },
  "users": [
    {
      "username": "service-account-difme-exchange",
      "enabled": true,
      "serviceAccountClientId": "difme-exchange",
      "realmRoles": [
        "ph-ee-transfer"
      ]
    },
    {
      "username": "service-account-ph-ee-ams",
      "enabled": true,
      "serviceAccountClientId": "ph-ee-ams",
      "realmRoles": []
    },
    {
      "username": "service-account-fineract-admin",
      "enabled": true,
      "serviceAccountClientId": "fineract-admin"
    }
  ]
}
