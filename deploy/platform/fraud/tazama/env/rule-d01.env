# Tazama rule D01 (ADR-023): DIFME's ONNX fraud model as a rule processor (services/fraud-rules/rule-d01).
# Database passwords are not here: they come from the tazama-db secret (manifests).
FUNCTION_NAME=rule-d01-rel-1-0-0
RULE_VERSION=1.0.0
RULE_NAME=D01
# "production" only makes Tazama require a Redis password; DIFME's shared Valkey is reached over the mesh (mTLS +
# authorization), without passwords. Nothing else in Tazama reads NODE_ENV (checked in v4.0.x).
NODE_ENV=dev
MAX_CPU=1
SUPPRESS_ALERTS=true
SIDECAR_HOST=
APM_URL=http://alloy.observability.svc:4317
APM_SECRET_TOKEN=
APM_ACTIVE=true
APM_SERVICE_NAME=tazama-rule-d01
LOCAL_CACHETTL=300
LOCAL_CACHE_ENABLED=true
RAW_HISTORY_DATABASE=tazama_raw_history
RAW_HISTORY_DATABASE_HOST=postgres-docdb.database-tier.svc
RAW_HISTORY_DATABASE_PORT=5432
RAW_HISTORY_DATABASE_USER=tazama
RAW_HISTORY_DATABASE_CERT_PATH=
CONFIGURATION_DATABASE=tazama_configuration
CONFIGURATION_DATABASE_HOST=postgres-docdb.database-tier.svc
CONFIGURATION_DATABASE_PORT=5432
CONFIGURATION_DATABASE_USER=tazama
CONFIGURATION_DATABASE_CERT_PATH=
EVENT_HISTORY_DATABASE=tazama_event_history
EVENT_HISTORY_DATABASE_HOST=postgres-docdb.database-tier.svc
EVENT_HISTORY_DATABASE_PORT=5432
EVENT_HISTORY_DATABASE_USER=tazama
EVENT_HISTORY_DATABASE_CERT_PATH=
LOG_LEVEL=info
STARTUP_TYPE=kafka
SERVER_URL=difme-kafka-bootstrap.streaming.svc:9092
# DIFME fraud scorer (ml-platform/onnx-serving); 300 ms per call, then .err (no weight).
FRAUD_SCORER_URL=http://onnx-serving.ml-platform.svc:8090
