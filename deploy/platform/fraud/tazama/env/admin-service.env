# Tazama admin-service (ADR-023): upstream defaults (tazama-stack v4.0.0 core/env) with DIFME's components. Serves the
# evaluation reports the payment hub reads for its fraud check. Database passwords come from the tazama-db secret.
FUNCTION_NAME=admin-service
MAX_CPU=1
NODE_ENV=dev
ACTIVE_CONDITIONS_ONLY=false
PORT=3100
APM_SERVICE_NAME=admin-service
APM_URL=http://alloy.observability.svc:4317
APM_SECRET_TOKEN=
APM_ACTIVE=true
REDIS_DATABASE=0
REDIS_SERVERS=[{"host":"valkey.cache-tier.svc", "port":6379}]
REDIS_AUTH=
REDIS_IS_CLUSTER=false
DISTRIBUTED_CACHETTL=300
DISTRIBUTED_CACHE_ENABLED=false
EVALUATION_DATABASE=tazama_evaluation
EVALUATION_DATABASE_HOST=postgres-docdb.database-tier.svc
EVALUATION_DATABASE_PORT=
EVALUATION_DATABASE_USER=tazama
EVALUATION_DATABASE_CERT_PATH=
CONFIGURATION_DATABASE=tazama_configuration
CONFIGURATION_DATABASE_HOST=postgres-docdb.database-tier.svc
CONFIGURATION_DATABASE_PORT=
CONFIGURATION_DATABASE_USER=tazama
CONFIGURATION_DATABASE_CERT_PATH=
EVENT_HISTORY_DATABASE=tazama_event_history
EVENT_HISTORY_DATABASE_HOST=postgres-docdb.database-tier.svc
EVENT_HISTORY_DATABASE_PORT=
EVENT_HISTORY_DATABASE_USER=tazama
EVENT_HISTORY_DATABASE_CERT_PATH=
RAW_HISTORY_DATABASE=tazama_raw_history
RAW_HISTORY_DATABASE_HOST=postgres-docdb.database-tier.svc
RAW_HISTORY_DATABASE_PORT=
RAW_HISTORY_DATABASE_USER=tazama
RAW_HISTORY_DATABASE_CERT_PATH=
LOG_LEVEL=info
STARTUP_TYPE=kafka
SERVER_URL=difme-kafka-bootstrap.streaming.svc:9092
SERVICE_CHANNEL_PRODUCER=service-channel
SERVICE_CHANNEL_CONSUMER=service-channel-ack
SERVICE_CHANNEL_SOURCE_URI_PREFIX=
AUTHENTICATED=false
CERT_PATH_PUBLIC=
CORS_POLICY=demo
