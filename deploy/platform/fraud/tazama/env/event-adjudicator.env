# Tazama event-adjudicator (ADR-023): upstream defaults (tazama-stack v4.0.0 core/env) with DIFME's components.
# Database passwords are not here: they come from the tazama-db secret (manifests).
FUNCTION_NAME=event-adjudicator
# "production" only makes Tazama require a Redis password; DIFME's shared Valkey is reached over the mesh (mTLS +
# authorization), without passwords. Nothing else in Tazama reads NODE_ENV (checked in v4.0.x).
NODE_ENV=dev
MAX_CPU=1
SUPPRESS_ALERTS=true
ALERTS_ONLY=false
SIDECAR_HOST=
APM_URL=http://alloy.observability.svc:4317
APM_SECRET_TOKEN=
APM_ACTIVE=true
APM_SERVICE_NAME=event-adjudicator
REDIS_DATABASE=0
REDIS_SERVERS=[{"host":"valkey.cache-tier.svc", "port":6379}]
REDIS_AUTH=
REDIS_IS_CLUSTER=false
DISTRIBUTED_CACHETTL=300
DISTRIBUTED_CACHE_ENABLED=false
LOCAL_CACHETTL=300
LOCAL_CACHE_ENABLED=false
RAW_HISTORY_DATABASE=tazama_raw_history
RAW_HISTORY_DATABASE_HOST=postgres-docdb.database-tier.svc
RAW_HISTORY_DATABASE_PORT=5432
RAW_HISTORY_DATABASE_USER=tazama
RAW_HISTORY_DATABASE_CERT_PATH=
CONFIGURATION_DATABASE=tazama_configuration
CONFIGURATION_DATABASE_HOST=postgres-docdb.database-tier.svc
CONFIGURATION_DATABASE_PORT=5432
CONFIGURATION_DATABASE_USER=tazama
CONFIGURATION_DATABASE_CERT_PATH=
EVALUATION_DATABASE=tazama_evaluation
EVALUATION_DATABASE_HOST=postgres-docdb.database-tier.svc
EVALUATION_DATABASE_PORT=5432
EVALUATION_DATABASE_USER=tazama
EVALUATION_DATABASE_CERT_PATH=
LOG_LEVEL=info
STARTUP_TYPE=kafka
SERVER_URL=difme-kafka-bootstrap.streaming.svc:9092
CONSUMER_STREAM=
SERVICE_CHANNEL_CONSUMER=service-channel
SERVICE_CHANNEL_PRODUCER=service-channel-ack
SERVICE_CHANNEL_CLASS=event-adjudicator
SERVICE_CHANNEL_SOURCE_URI_PREFIX=
ALERT_DESTINATION=global
ALERT_PRODUCER=investigation-service
