{
  "compilerOptions": {
    "declaration": true, "importHelpers": true, "target": "ES2022", "module": "NodeNext", "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"], "outDir": "lib", "rootDir": "src", "sourceMap": true, "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["./src/**/*"]
}
