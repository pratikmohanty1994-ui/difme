{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIFME wallet",
  "version": "0.1.0",
  "identifier": "dev.difme.edge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DIFME wallet", "width": 420, "height": 760 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
