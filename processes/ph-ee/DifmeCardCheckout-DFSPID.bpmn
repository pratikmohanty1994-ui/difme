<?xml version="1.0" encoding="UTF-8"?>
<!--
  DIFME card checkout for Mifos Payment Hub EE (D3: card checkout off the interim hub). Written in PH-EE's Zeebe dialect
  and converted for Fluxnova by ci/zeebe-bpmn-to-fluxnova.py, like the other flows.
  Authorises a buying partner's card through Hyperswitch (DIFME's PSP: card network via the acquirer and the scheme),
  checks the payment on Tazama before any money is taken (ADR-023, as the interim hub did), then captures it (no alert),
  holds it for review (alert, or no verdict unless the worker fails open) or cancels the authorisation (interdiction).
  All tasks are answered by services/core/rails-worker. It resolves the card from its own cards-on-file by cardRef,
  so no card number is ever a process variable (Fluxnova's database stays out of the cardholder-data environment).
  Variables in: paymentId (idempotency key at the PSP), merchant, amountMinor, currency, cardRef, payer (DIFME's id for the
  cardholder, for Tazama), description. Out: chargeStatus (succeeded | declined | review | failed), declineCode,
  declineMessage, pspPaymentId, fraudVerdict, fraudDetail. The caller (exchange-svc's PhEePaymentHub) then credits the
  merchant with an on-us transfer (DifmeOnUsTransfer) and refunds (DifmeCardRefund) if that is refused.
  Transient failures (PSP unreachable) are retried by the worker; when retries run out Fluxnova raises an incident.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="difme-cardcheckout" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="DifmeCardCheckout-DFSPID" name="DIFME card checkout" isExecutable="true">
    <bpmn:startEvent id="start" name="Request"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="psp" name="Authorise card (Hyperswitch)">
      <bpmn:extensionElements><zeebe:taskDefinition type="hyperswitch-charge" retries="5" /></bpmn:extensionElements>
      <bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="authorised" default="s3"><bpmn:incoming>s2</bpmn:incoming><bpmn:outgoing>s3</bpmn:outgoing><bpmn:outgoing>declinedFlow</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="fraud" name="Fraud check (Tazama)">
      <bpmn:extensionElements><zeebe:taskDefinition type="tazama-check" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>s3</bpmn:incoming><bpmn:outgoing>s4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="verdict" default="s5"><bpmn:incoming>s4</bpmn:incoming><bpmn:outgoing>s5</bpmn:outgoing><bpmn:outgoing>cancelFlow</bpmn:outgoing><bpmn:outgoing>reviewFlow</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="capture" name="Capture (Hyperswitch)">
      <bpmn:extensionElements><zeebe:taskDefinition type="hyperswitch-capture" retries="5" /></bpmn:extensionElements>
      <bpmn:incoming>s5</bpmn:incoming><bpmn:outgoing>s6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="cancel" name="Cancel authorisation (fraud)">
      <bpmn:extensionElements><zeebe:taskDefinition type="hyperswitch-cancel" retries="5" /></bpmn:extensionElements>
      <bpmn:incoming>cancelFlow</bpmn:incoming><bpmn:outgoing>s7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="done" name="Answered"><bpmn:incoming>s6</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="declined" name="Declined"><bpmn:incoming>declinedFlow</bpmn:incoming><bpmn:incoming>s7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="review" name="Held for review"><bpmn:incoming>reviewFlow</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="start" targetRef="psp" />
    <bpmn:sequenceFlow id="s2" sourceRef="psp" targetRef="authorised" />
    <bpmn:sequenceFlow id="s3" sourceRef="authorised" targetRef="fraud" />
    <bpmn:sequenceFlow id="declinedFlow" sourceRef="authorised" targetRef="declined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= chargeStatus = "declined"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s4" sourceRef="fraud" targetRef="verdict" />
    <bpmn:sequenceFlow id="s5" sourceRef="verdict" targetRef="capture" />
    <bpmn:sequenceFlow id="cancelFlow" sourceRef="verdict" targetRef="cancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraudAction = "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="reviewFlow" sourceRef="verdict" targetRef="review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fraudAction = "review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s6" sourceRef="capture" targetRef="done" />
    <bpmn:sequenceFlow id="s7" sourceRef="cancel" targetRef="declined" />
  </bpmn:process>
</bpmn:definitions>
